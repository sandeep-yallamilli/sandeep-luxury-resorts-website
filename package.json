{
  "name": "sandeep-luxury-resorts-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"DJANGO,VITE\" --prefix-colors \"bgMagenta.bold,bgCyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && venv\\Scripts\\python manage.py runserver 8000",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && venv\\Scripts\\pip install -r requirements.txt"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.77"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
